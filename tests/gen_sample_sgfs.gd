# 生成几个具有代表性的对局 SGF 棋谱（合法手数）
# 用法: godot --headless --script res://tests/gen_sample_sgfs.gd
extends SceneTree

const SGFLoader = preload("res://scripts/core/SGFLoader.gd")

func _init() -> void:
	# 1. 棋圣秀策流水对局（1862 御城碁风格）
	_gen_shusaku()
	# 2. 武宫正树宇宙流（1980s 风格）
	_gen_cosmic()
	# 3. 柯洁 vs AlphaGo 风格（2017 现代攻杀）
	_gen_kejie_alphago()
	# 4. 李昌镕稳扎稳打风格（1990s）
	_gen_changho()
	# 5. 当代柯洁风格（2020s）
	_gen_kejie_modern()
	print("棋谱生成完成")
	quit(0)

# 写入 SGF 文件
func _write_sgf(path: String, black: String, white: String, date: String,
		result: String, event: String, moves: Array) -> void:
	var s := "(;GM[1]FF[4]AP[边境线棋谱库]SZ[19]\n"
	s += "PB[%s]\n" % black
	s += "PW[%s]\n" % white
	s += "DT[%s]\n" % date
	s += "RE[%s]\n" % result
	s += "EV[%s]\n" % event
	s += "KM[0.0]\n"
	for i in moves.size():
		var mv: Dictionary = moves[i]
		var color_char: String = "B" if mv.color == 1 else "W"
		var coord: String = _coord_to_sgf(mv.pos)
		if i % 10 == 0:
			s += "\n"
		s += ";%s[%s]" % [color_char, coord]
	s += "\n)\n"
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f:
		f.store_string(s)
		f.close()
		print("写入: %s (%d 手)" % [path, moves.size()])
	else:
		push_error("无法写入: %s" % path)

# Vector2i(col, row) → SGF 字母坐标（如 "pd"）
func _coord_to_sgf(pos: Vector2i) -> String:
	var col_str: String = char(ord('a') + pos.x)
	var row_str: String = char(ord('a') + pos.y)
	return col_str + row_str

