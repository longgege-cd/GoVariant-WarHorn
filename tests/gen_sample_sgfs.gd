# [color, col, row] → Dictionary
func _build_moves(triples: Array) -> Array:
	var moves: Array = []
	for t in triples:
		moves.append({
			"color": int(t[0]),
			"pos": Vector2i(int(t[1]), int(t[2])),
			"pass": false,
		})
	return moves
