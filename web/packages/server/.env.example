# ====== 战争号角 WEB 服务器配置示例 ======
# 复制本文件为 packages/server/.env 后按需修改；修改后重启服务器生效。
# 真实环境变量优先于本文件；未设置的项使用代码内默认值（见 src/Config.ts）。

# ---- 游戏平衡参数（公测调参用，每局对局会快照这些值）----

# 贴目（黑方扣减，默认 0.5）
#WARHORN_KOMI=0.5

# 每方兵力上限（默认 120，v7.3）
#WARHORN_PIECE_LIMIT=120

# 正式阶段基础时间（秒，默认 600 = 10 分钟）
#WARHORN_TIMER_BASE_SEC=600

# 每手加时（秒，读秒制已弃用，默认 0）
#WARHORN_TIMER_INCREMENT_SEC=0

# 每次读秒秒数（默认 60）
#WARHORN_BYO_PERIOD_SEC=60

# 读秒次数（默认 5）
#WARHORN_BYO_COUNT=5

# 布局阶段每方独立时间（秒，默认 60）
#WARHORN_DEPLOY_TIMER_SEC=60

# ---- 管理接口 ----

# /admin/stats 访问令牌（留空则不鉴权；设置后需带 x-admin-token 请求头）
#WARHORN_ADMIN_TOKEN=change-me

# ---- 服务基础配置 ----

# HTTP 监听端口（默认 3000）
#PORT=3000

# CORS 允许来源（默认 *；生产建议设为前端域名）
#CORS_ORIGIN=*
